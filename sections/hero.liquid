<section
  class="py-16 md:py-0 min-h-[50dvh] sm:min-h-[75dvh] md:min-h-[calc(100dvh-67.95px)] flex flex-col justify-center bg-cover bg-center bg-no-repeat relative"
  style="background-image: url('../assets/converse-vans.webp');"
>
  <header class="h-auto text-center max-w-115 w-[90%] mx-auto">
    <p class="font-secondary text-neutral text-2xl md:text-[2rem] uppercase tracking-[-2px] [-webkit-text-stroke:1px_black] md:[-webkit-text-stroke:2px_black] leading-none mbe-4">Mix & match</p>
    <h2 class="header-main header-main--primary text-7xl md:text-[7.5rem] mbe-6 md:mbe-[2rem]">Buy 3 - take 4</h2>
    <a
      href="#"
      class="btn"
    >
      Shop Now
    </a>
  </header>
  <div class="absolute bottom-0 w-full">
    {% render 'colorful-separator' %}
  </div>
</section>


