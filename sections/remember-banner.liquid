<section
  class="remember-banner py-16 md:py-0 md:h-194.5 flex flex-col justify-center"
  style="--remember-banner-background: url('{{ 'feel-your-soul-stickers.webp' | asset_url }}');"
>
  <header class="flex flex-col h-auto items-center content-center gap-4 md:gap-8 text-center max-w-125 w-[90%] mx-auto">
    <h2 class="header-punk header-punk--section-header header-punk--primary text-4xl">Remember the 4th one is for free!!</h2>
    <a
      href="#"
      class="btn"
    >
      Shop Now
    </a>
  </header>
</section>

{% render 'colorful-separator' %}

{% stylesheet %}
  .remember-banner {
    background-image: var(--remember-banner-background);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Remember Banner",
  "settings": [],
  "presets": [
    {
      "name": "Remember Banner Template",
      "category": "Demo"
    }
  ]
}
{% endschema %}
