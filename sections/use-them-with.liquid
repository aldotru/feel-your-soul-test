<section class="section-padding pbe-22! sm:pbe-24!">
  <div class="container">
    <header class="mbe-6 sm:mbe-8 max-w-130 md:max-w-156.5 mx-auto">
      <h2 class="header-punk header-punk--section-header header-punk--primary sm:text-center">Use them with</h2>
    </header>
    <div class="flex flex-col sm:flex-row gap-16 sm:gap-8 items-center justify-between">
      <div class="w-full sm:w-1/2 relative">
        <figure
            style="background-image: url('../assets/bg-black-white-squares.webp');"
            class="media-bg-box w-full p-3 sm:p-6 border-4 sm:border-8 border-black rounded-2xl bg-gray-300 relative"
          >
          <figcaption class="absolute left-1/2 -translate-x-1/2 top-6 sm:top-8">
            <header>
              <h3 class="header-punk header-punk--primary text-4xl xs:text-4xl md:text-5xl text-center">Vans</h3>
            </header>
          </figcaption>
          <img
            src="{{ 'holding-vans.webp' | asset_url }}"
            alt="Hands holding a pair of Vans"
            width="562"
            height="699"
            loading="lazy"
            class="rounded-lg w-full h-full"
          />
        </figure>
        <a
          href="#"
          class="btn btn--primary absolute -bottom-6 left-1/2 -translate-x-1/2"
        >
          Shop Now
        </a>
      </div>
      <div class="w-full sm:w-1/2 relative">
        <figure
            style="background-image: url('../assets/bg-jeans.webp');"
            class="media-bg-box w-full p-3 sm:p-6 border-4 sm:border-8 border-black rounded-2xl bg-gray-300 relative"
          >
          <figcaption class="absolute left-1/2 -translate-x-1/2 top-6 sm:top-8">
            <header>
              <h3 class="header-punk header-punk--primary text-4xl xs:text-4xl md:text-5xl text-center">Converse</h3>
            </header>
          </figcaption>
          <img
            src="{{ 'holding-converse.webp' | asset_url }}"
            alt="Hands holding a pair of Converse"
            width="562"
            height="699"
            loading="lazy"
            class="rounded-lg w-full h-full"
          />
        </figure>
        <a
          href="#"
          class="btn btn--primary absolute -bottom-6 left-1/2 -translate-x-1/2"
        >
          Shop Now
        </a>
      </div>
    </div>
  </div>
</section>

{% render 'colorful-separator' %}

{% schema %}
{
  "name": "Use The With",
  "settings": []
}
{% endschema %}
